{
  "name": "CloudTasks course",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "CloudTasks",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postCreateCommand": "python -m pip install -r requirements-lock.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
